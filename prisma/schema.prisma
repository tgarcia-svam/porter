generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users    User[]
  projects ProjectOrganization[]

  @@index([deletedAt])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  schemas       SchemaProject[]
  organizations ProjectOrganization[]

  @@index([deletedAt])
}

model ProjectOrganization {
  projectId      String
  organizationId String
  assignedAt     DateTime @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([projectId, organizationId])
}

model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  name                String?
  role                Role          @default(UPLOADER)
  organizationId      String?
  failedLoginAttempts Int           @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  uploads      FileUpload[]
}

model Schema {
  id                    String       @id @default(cuid())
  name                  String
  description           String?
  timeSeriesColumn      String?
  timeSeriesGranularity Granularity?
  version               Int          @default(1)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  projects SchemaProject[]
  columns  SchemaColumn[]
  uploads  FileUpload[]

  @@index([deletedAt])
}

model SchemaProject {
  schemaId   String
  projectId  String
  assignedAt DateTime @default(now())

  schema  Schema  @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([schemaId, projectId])
}

model SchemaColumn {
  id               String          @id @default(cuid())
  schemaId         String
  name             String
  dataType         DataType
  required         Boolean         @default(true)
  order            Int             @default(0)
  classificationId String?

  schema           Schema          @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  classification   Classification? @relation(fields: [classificationId], references: [id], onDelete: SetNull)
}

model Classification {
  id            String        @id @default(cuid())
  name          String        @unique
  values        String[]
  caseSensitive Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  columns   SchemaColumn[]
}

model FileUpload {
  id            String       @id @default(cuid())
  userId        String
  schemaId      String
  schemaVersion Int          @default(1)
  fileName      String
  blobUrl       String?
  status        UploadStatus @default(PENDING)
  errorCount    Int          @default(0)
  rowCount      Int          @default(0)
  errorsCapped  Boolean      @default(false)
  createdAt     DateTime     @default(now())
  deletedAt     DateTime?

  // Data-warehouse export tracking. Export runs best-effort after an upload
  // finalizes VALID; failure here never changes `status`. exportPath is the
  // blob path written in the external (data-team-owned) storage account.
  exportStatus   ExportStatus @default(NOT_EXPORTED)
  exportedAt     DateTime?
  exportPath     String?
  exportError    String?
  exportAttempts Int          @default(0)

  user    User               @relation(fields: [userId], references: [id])
  schema  Schema             @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  results ValidationResult[]
  rows    UploadRow[]

  @@index([deletedAt])
  @@index([createdAt])
  // Accelerates "latest VALID upload for this schema" lookups (latest-data, stats).
  @@index([schemaId, status, createdAt(sort: Desc)])
}

model UploadRow {
  id        String     @id @default(cuid())
  uploadId  String
  rowIndex  Int
  data      Json
  createdAt DateTime   @default(now())

  upload FileUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  // Compound index makes paginated reads (orderBy rowIndex, skip/take) a single
  // index scan instead of a sort over all rows of a given upload.
  @@index([uploadId, rowIndex])
}

model ValidationResult {
  id       String @id @default(cuid())
  uploadId String
  row      Int
  column   String
  value    String?
  error    String

  upload FileUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  userId    String?
  userEmail String?
  action    String   // create | update | delete | upsert | createMany | updateMany | deleteMany
  model     String
  recordId  String?
  ipAddress String?

  @@index([timestamp])
  @@index([userId])
  @@index([model, timestamp])
}

enum Role {
  ADMIN
  UPLOADER
}

enum DataType {
  TEXT
  NUMBER
  INTEGER
  BOOLEAN
  DATE
  EMAIL
}

enum UploadStatus {
  PENDING
  VALID
  INVALID
}

enum ExportStatus {
  NOT_EXPORTED
  EXPORTED
  FAILED
}

enum Granularity {
  DAY
  MONTH
  YEAR
}
