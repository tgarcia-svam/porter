generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users    User[]
  projects ProjectOrganization[]

  @@index([deletedAt])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  schemas       SchemaProject[]
  organizations ProjectOrganization[]

  @@index([deletedAt])
}

model ProjectOrganization {
  projectId      String
  organizationId String
  assignedAt     DateTime @default(now())

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([projectId, organizationId])
}

model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  name                String?
  role                Role          @default(UPLOADER)
  organizationId      String?

  // ── Authentication ──────────────────────────────────────────────────────────
  // authMethod is the admin's choice of how this user signs in. New users default
  // to PASSWORD; existing (pre-migration) users are backfilled to SSO so they keep
  // working. passwordHash/mfaSecretEnc are null for SSO users.
  authMethod          AuthMethod    @default(PASSWORD)
  passwordHash        String?       // bcrypt hash — never the plaintext password
  mfaEnabled          Boolean       @default(false)
  mfaSecretEnc        String?       // AES-256-GCM encrypted TOTP secret (base64)

  // ── Lockout ──────────────────────────────────────────────────────────────────
  // Two-tier: failedLoginAttempts within a 15-min window (tracked by
  // lastFailedLoginAt) drives a temporary cooldown (lockedUntil); enough failures
  // trip lockedForReset, a hard lock cleared only by a successful password reset.
  failedLoginAttempts Int           @default(0)
  lastFailedLoginAt   DateTime?
  lockedUntil         DateTime?
  lockedForReset      Boolean       @default(false)

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  uploads      FileUpload[]
  authTokens   AuthToken[]
  passkeys     Passkey[]
}

// WebAuthn/passkey credential — an alternative MFA second factor to TOTP for
// PASSWORD accounts (biometric / security-key tap instead of a typed code). Only
// the public key is stored (public keys are not secret); the private key never
// leaves the user's device. `counter` is the signature counter used for
// clone-detection; `credentialId` is the base64url credential id.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String[]
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use, hashed tokens backing the invite / password-reset / MFA-enrollment
// flows. The raw token is emailed to the user (or handed to the client) once and
// never persisted — only its SHA-256 hash is stored, so a DB leak yields no usable
// tokens. secretEnc holds the candidate (encrypted) TOTP secret during enrollment,
// promoted onto User.mfaSecretEnc only after the user confirms a valid code.
model AuthToken {
  id         String           @id @default(cuid())
  userId     String
  tokenHash  String           @unique
  purpose    AuthTokenPurpose
  secretEnc  String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Schema {
  id                    String       @id @default(cuid())
  name                  String
  description           String?
  version               Int          @default(1)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  deletedAt             DateTime?

  projects       SchemaProject[]
  columns        SchemaColumn[]
  uploads        FileUpload[]
  visualizations Visualization[]

  @@index([deletedAt])
}

model Visualization {
  id          String            @id @default(cuid())
  schemaId    String
  type        VisualizationType
  title       String
  order       Int               @default(0)
  aggregate   AggregateFn
  valueColumn String                                  // column the aggregate runs on (y / indicator)
  xColumn     String?                                 // category/x-axis column (BAR/LINE only)
  granularity Granularity?                            // date bucketing when xColumn is a DATE column
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  schema Schema @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  @@index([schemaId, order])
}

model SchemaProject {
  schemaId   String
  projectId  String
  assignedAt DateTime @default(now())

  schema  Schema  @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([schemaId, projectId])
}

model SchemaColumn {
  id               String          @id @default(cuid())
  schemaId         String
  name             String
  dataType         DataType
  required         Boolean         @default(true)
  order            Int             @default(0)
  classificationId String?

  schema           Schema          @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  classification   Classification? @relation(fields: [classificationId], references: [id], onDelete: SetNull)
}

model Classification {
  id            String             @id @default(cuid())
  name          String             @unique
  description   String?                               // uploader-facing explanation of the rule
  type          ClassificationType @default(VALUE_LIST)
  values        String[]                              // VALUE_LIST
  caseSensitive Boolean            @default(true)     // VALUE_LIST + REGEX (regex `i` flag)
  pattern       String?                               // REGEX
  minNumber     Float?                                // NUMBER_RANGE
  maxNumber     Float?                                // NUMBER_RANGE
  minDate       DateTime?          @db.Date           // DATE_RANGE (date-only, UTC midnight)
  maxDate       DateTime?          @db.Date           // DATE_RANGE
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  columns   SchemaColumn[]
}

model FileUpload {
  id            String       @id @default(cuid())
  userId        String
  schemaId      String
  schemaVersion Int          @default(1)
  fileName      String
  blobUrl       String?
  status        UploadStatus @default(PENDING)
  errorCount    Int          @default(0)
  rowCount      Int          @default(0)
  errorsCapped  Boolean      @default(false)
  createdAt     DateTime     @default(now())
  deletedAt     DateTime?

  // Data-warehouse export tracking. Export runs best-effort after an upload
  // finalizes VALID; failure here never changes `status`. exportPath is the
  // blob path written in the external (data-team-owned) storage account.
  exportStatus   ExportStatus @default(NOT_EXPORTED)
  exportedAt     DateTime?
  exportPath     String?
  exportError    String?
  exportAttempts Int          @default(0)

  user    User               @relation(fields: [userId], references: [id])
  schema  Schema             @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  results ValidationResult[]
  rows    UploadRow[]

  @@index([deletedAt])
  @@index([createdAt])
  // Accelerates "latest VALID upload for this schema" lookups (latest-data, stats).
  @@index([schemaId, status, createdAt(sort: Desc)])
}

model UploadRow {
  id        String     @id @default(cuid())
  uploadId  String
  rowIndex  Int
  data      Json
  createdAt DateTime   @default(now())

  upload FileUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  // Compound index makes paginated reads (orderBy rowIndex, skip/take) a single
  // index scan instead of a sort over all rows of a given upload.
  @@index([uploadId, rowIndex])
}

model ValidationResult {
  id       String @id @default(cuid())
  uploadId String
  row      Int
  column   String
  value    String?
  error    String

  upload FileUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  userId    String?
  userEmail String?
  action    String   // create | update | delete | upsert | createMany | updateMany | deleteMany
  model     String
  recordId  String?
  ipAddress String?

  @@index([timestamp])
  @@index([userId])
  @@index([model, timestamp])
}

enum Role {
  ADMIN
  UPLOADER
}

enum AuthMethod {
  PASSWORD
  SSO
}

enum AuthTokenPurpose {
  INVITE
  RESET
  MFA_ENROLL
}

enum DataType {
  TEXT
  NUMBER
  INTEGER
  BOOLEAN
  DATE
  EMAIL
}

enum ClassificationType {
  VALUE_LIST
  REGEX
  NUMBER_RANGE
  DATE_RANGE
}

enum UploadStatus {
  PENDING
  VALID
  INVALID
}

enum ExportStatus {
  NOT_EXPORTED
  EXPORTED
  FAILED
}

enum VisualizationType {
  INDICATOR
  BAR
  LINE
}

enum AggregateFn {
  COUNT
  SUM
  AVG
  MIN
  MAX
  MEDIAN
}

enum Granularity {
  DAY
  MONTH
  YEAR
}
