# Copy this file to .env and fill in the values:  cp .env.example .env
#
# A single gitignored .env is the source for ALL local dev config. It is read by
# both the Prisma CLI (db push / generate / seed / rls) and the Next.js runtime
# (next dev / build), so secrets and non-secrets can live together here. In
# production none of this is used — values come from App Service settings + Key Vault.

# ── Key Vault ──────────────────────────────────────────────────────
KEY_VAULT_URL=https://<your-keyvault>.vault.azure.net/

# ── Auth ───────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── SSO providers ──────────────────────────────────────────────────
# Client IDs / tenant are non-secret and live here (App Service application
# settings in production). The matching client SECRETS are loaded into
# process.env from Azure Key Vault at startup (see src/lib/secrets.ts):
#   google-client-secret -> GOOGLE_CLIENT_SECRET
#   sso-porter           -> AZURE_AD_CLIENT_SECRET
# A provider is enabled only when both its ID and secret are present.
GOOGLE_CLIENT_ID= 
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=common

# ── Azure Storage ──────────────────────────────────────────────────
AZURE_STORAGE_CONTAINER=porter-uploads
AZURE_STORAGE_ACCOUNT_URL=https://<your-storage-account>.blob.core.windows.net/

# ── Azure Service Bus (optional — enables async background processing) ──
# When set, large file uploads are processed asynchronously via a queue.
# Without this, uploads are processed synchronously within the HTTP request.
# Namespace format: <your-namespace>.servicebus.windows.net
AZURE_SERVICE_BUS_NAMESPACE=
AZURE_SERVICE_BUS_QUEUE_NAME=porter-uploads
# Shared secret the Azure Function sends in X-Worker-Secret when calling
# /api/upload/process. Generate with: openssl rand -hex 32
UPLOAD_WORKER_SECRET=

# Shared secret the scheduled retention job sends in x-worker-secret when
# calling /api/admin/retention/run. Generate with: openssl rand -hex 32
RETENTION_WORKER_SECRET=

# ── Data-warehouse export ──
# The destination (storage account URL, tenant ID, client ID, container, root
# path) is configured in the admin Settings UI and stored in the database — NOT
# here. The only env var is the client ID of Porter's user-assigned managed
# identity, which federates (secret-less, cross-tenant) into the data team's app.
# On Azure these are injected automatically by bicep; locally they are absent, so
# exports are reported as unavailable. WAREHOUSE_MI_PRINCIPAL_ID is shown read-only
# in the admin UI as the federated-credential subject for the data team.
WAREHOUSE_MI_CLIENT_ID=
WAREHOUSE_MI_PRINCIPAL_ID=

# ── Local auth (username/password + MFA) ───────────────────────────
# Email delivery for invite / password-reset links via Azure Communication
# Services. On Azure these are injected by bicep (connection string from Key
# Vault, sender from the managed email domain). Locally, leave ACS_CONNECTION_STRING
# empty to log links to the console instead of sending real email.
ACS_CONNECTION_STRING=
EMAIL_SENDER_ADDRESS=DoNotReply@<your-managed-domain>.azurecomm.net
# AES-256 key (base64, 32 bytes) encrypting MFA TOTP secrets at rest.
# In production loaded from Key Vault (mfa-encryption-key). Generate with:
#   openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# ── Database (required by Prisma CLI — keep in sync with .env.local) ──
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/porter

# ── Seed ───────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=you@example.com
